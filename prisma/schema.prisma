generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteSettings {
  id            String @id @default("site")
  name          String
  shortName     String
  footerTagline String
  homeMarquee   String
}

model NavLink {
  id        String @id @default(cuid())
  href      String
  label     String
  group     String
  sortOrder Int

  @@unique([group, href])
}

/// slug: home | about | services | galleries | faq
model SitePage {
  slug            String @id
  metaTitle       String
  metaDescription String
  copy            Json
}

model Service {
  id          String @id @default(cuid())
  title       String
  tagline     String
  description String
  price       String
  sortOrder   Int    @unique
}

model ProcessStep {
  id          String @id @default(cuid())
  step        Int    @unique
  title       String
  description String
}

model Testimonial {
  id        String @id @default(cuid())
  quote     String
  name      String
  sortOrder Int    @unique
}

model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @unique
}

model Product {
  id           String           @id @default(cuid())
  title        String
  imageUrl     String
  sortOrder    Int              @unique
  galleryItems GalleryRowItem[]
}

model GalleryRow {
  id        String           @id @default(cuid())
  sortOrder Int
  direction String
  duration  Int
  isPreview Boolean          @default(false)
  items     GalleryRowItem[]
}

model GalleryRowItem {
  id        String     @id @default(cuid())
  rowId     String
  productId String
  sortOrder Int
  row       GalleryRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([rowId, sortOrder])
}

model LegalDocument {
  slug        String         @id
  title       String
  lastUpdated String
  intro       String
  sections    LegalSection[]
}

model LegalSection {
  id           String        @id @default(cuid())
  documentSlug String
  heading      String
  paragraphs   String[]
  bullets      String[]      @default([])
  sortOrder    Int
  document     LegalDocument @relation(fields: [documentSlug], references: [slug], onDelete: Cascade)

  @@unique([documentSlug, sortOrder])
}

model Banner {
  id        String @id @default(cuid())
  title     String
  content   String
  imageUrl  String
  sortOrder Int    @unique
}
